# =============================================================
# TECH TURF — Environment Variables Template for Vercel & Production
# Set these variables in Vercel Project Settings -> Environment Variables
# =============================================================

NODE_ENV=production
PORT=5000

# --- Security ---
# Generate a strong random secret: node -e "console.log(crypto.randomBytes(64).toString('hex'))"
JWT_SECRET=your-production-jwt-secret-key-change-this

# --- Email (Nodemailer / Gmail) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# --- AI Integration ---
# Google Gemini API key for Nexus AI
GEMINI_API_KEY=your-gemini-api-key
NEXUS_AI_API_KEY=your-nexus-ai-key

# --- OAuth (Optional) ---
GOOGLE_CLIENT_ID=your-google-client-id

# --- CORS & Frontend URL ---
CORS_ORIGIN=https://your-vercel-domain.vercel.app
FRONTEND_BASE_URL=https://your-vercel-domain.vercel.app
